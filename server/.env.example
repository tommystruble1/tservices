# Copy this file to .env for local dev, and set the same names as Environment
# Variables in the Vercel project once deployed. Never commit the real .env.

# Postgres connection string — a free Neon (neon.tech) project works well.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth's own signing secret and public URL.
#   generate a secret with:  openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-backend.vercel.app

# The static site this backend accepts requests from. Used for CORS and for
# building Stripe's success/cancel redirect URLs.
ALLOWED_ORIGIN=https://tservices.cc
SITE_URL=https://tservices.cc

# From the Stripe dashboard — Developers → API keys, and Developers → Webhooks
# once you've added the endpoint (see server/README.md).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
